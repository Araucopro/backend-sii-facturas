# Configuración de Base de Datos MongoDB
MONGODB_URI=mongodb://localhost:27017/sii_facturas

# Puerto del servidor
PORT=3000

# Clave maestra de 32 bytes (64 caracteres hexadecimales) para cifrado AES-256-GCM de certificados
CERTIFICATE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ambiente SII: CERTIFICATION (maullin.sii.cl) o PRODUCTION (palena.sii.cl).
# Por defecto CERTIFICATION. En certificación la carátula del EnvioDTE usa
# siempre nroResol=0 y fchResol=2014-08-22 (valores oficiales del set de
# pruebas); en producción se usa la resolución real configurada por tenant
# vía PUT /tenants/issuer.
SII_ENVIRONMENT=CERTIFICATION
